<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o mayor: ni respaldo en la nube ni transferencia a otro teléfono
     llevan datos de la app (tokens, preferencias, archivos). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
